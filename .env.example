# Путь к JSON-ключу Google Service Account.
# Таблица или папка Drive должна быть расшарена на client_email из этого файла.
GOOGLE_SHEETS_CREDENTIALS=config/credentials/google/google-service-account.json

# Необязательные значения по умолчанию для CLI-команд.
GOOGLE_SHEETS_SPREADSHEET=
GOOGLE_SHEETS_WORKSHEET=
GOOGLE_SHEETS_DRIVE_FOLDER_ID=
